PORT=8000
# Postgres connection pool size (replaces WORKERS, which meant WORKERS*8).
DB_MAX_CONNS=32
SUPERUSER_EMAIL=pentaract@pentaract.pentaract
SUPERUSER_PASS=pentaract
ACCESS_TOKEN_EXPIRE_IN_SECS=1800
# Signs the JWT sessions. Also derives the chunk encryption key unless ENCRYPTION_KEY is set.
SECRET_KEY=XXX
# Optional dedicated chunk encryption secret. Set it on a fresh install, or later:
# chunks uploaded before the change are still decrypted with SECRET_KEY, so
# keep SECRET_KEY unchanged as long as any of them exist.
# ENCRYPTION_KEY=YYY
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_RATE_LIMIT=18

DATABASE_USER=pentaract
DATABASE_PASSWORD=pentaract
DATABASE_NAME=pentaract
DATABASE_HOST=db
DATABASE_PORT=5432

# Local filesystem upload (optional).
# Set to the host directory to expose inside the container (e.g. /home/user/media).
# Also uncomment the volume mount in docker-compose.yml.
# LOCAL_UPLOAD_BASE_PATH=/path/on/host

# Database backup settings (optional).
# BACKUP_RETENTION_DAYS=7
# BACKUP_INTERVAL_SECONDS=86400
